# The Gemma weights (~3GB) are NEVER committed. They are fetched at build time
# by scripts/fetch-model.mjs and copied into the app bundle by CocoaPods.
ios/model/
*.task
*.tflite
*.bin

# LiteRT-LM prebuilt framework: ~85 MB, fetched by scripts/fetch-litertlm.mjs
ios/vendor/CLiteRTLM.xcframework/
ios/vendor/*.zip
